{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
	"dependencyDashboard": true,
	"semanticCommits": "enabled",
	"labels": ["dependencies"],
	"minimumReleaseAge": "3 days",
	"prConcurrentLimit": 3,
	"prHourlyLimit": 1,
	"vulnerabilityAlerts": {
		"enabled": true
	},
	"docker-compose": {
		"enabled": true
	},
	"git-submodules": {
		"enabled": true
	},
	"packageRules": [
		{
			"description": "Major updates: never automerge, hold for manual approval on the dashboard.",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"dependencyDashboardApproval": true
		},
		{
			"description": "Pin Dockerfile base image digests.",
			"matchManagers": ["dockerfile"],
			"pinDigests": true
		},
		{
			"description": "Move the internal binary and every outer Caddy edge together.",
			"matchPackageNames": ["caddy", "library/caddy"],
			"groupName": "caddy",
			"pinDigests": true
		},
		{
			"description": "Group Node runtime pins so .nvmrc, package engines, and the Docker base image move together.",
			"matchPackageNames": ["node", "library/node"],
			"groupName": "node runtime"
		},
		{
			"description": "Group Rust toolchain pins so the CI toolchain and the Docker build image move together; Cargo's rust-version is pinned to them by a test.",
			"matchPackageNames": ["rust", "library/rust", "dtolnay/rust-toolchain"],
			"groupName": "rust toolchain"
		},
		{
			"description": "Automerge low-risk updates once CI + smoke pass.",
			"matchUpdateTypes": ["patch", "pin", "digest"],
			"automerge": true
		},
		{
			"description": "Automerge dev dependency minor + patch once CI passes.",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["minor", "patch"],
			"automerge": true
		},
		{
			"description": "Group + automerge GitHub Actions bumps (digest/minor/patch).",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["digest", "pin", "patch", "minor"],
			"groupName": "github-actions",
			"automerge": true
		},
		{
			"description": "Group + automerge the Dockerfile build tools.",
			"matchPackageNames": ["bun", "npm", "pnpm", "cargo-chef"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "build tools",
			"automerge": true
		},
		{
			"description": "Never bump our own published image.",
			"matchPackageNames": ["ghcr.io/sloikodavid/composery"],
			"enabled": false
		},
		{
			"description": "Patched in pnpm-workspace.yaml, where the patch filename embeds the exact version: a bump that does not also regenerate the patch fails to install. Hold for manual regeneration.",
			"matchPackageNames": ["fumadocs-mdx", "fumadocs-ui"],
			"automerge": false,
			"dependencyDashboardApproval": true
		},
		{
			"description": "Clerk is version-locked by the overrides in pnpm-workspace.yaml (@clerk/ui imports an internal hook @clerk/shared dropped after 4.14.0). Move the whole set by hand or not at all.",
			"matchPackageNames": ["@clerk/**"],
			"groupName": "clerk",
			"automerge": false,
			"dependencyDashboardApproval": true
		},
		{
			"description": "Expo pins its own dependency set per SDK; `expo install --check` is the source of truth. Bumping one package to the next SDK's version breaks that alignment, so group the SDK and take it deliberately.",
			"matchPackageNames": [
				"expo",
				"expo-**",
				"@expo/**",
				"react-native",
				"react-native-**"
			],
			"groupName": "expo sdk",
			"automerge": false,
			"dependencyDashboardApproval": true
		},
		{
			"description": "Hold code-server submodule bumps for manual patch-rebase; a new release can break the quilt stack.",
			"matchManagers": ["git-submodules"],
			"automerge": false,
			"dependencyDashboardApproval": true
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^Dockerfile$/"],
			"matchStrings": [
				"#\\s*renovate:\\s*datasource=(?<datasource>npm|crate)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*ARG\\s+\\S+=(?<currentValue>\\S+)"
			]
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/mobile-e2e\\.yml$/"],
			"matchStrings": [
				"#\\s*renovate:\\s*datasource=(?<datasource>github-releases)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*MAESTRO_VERSION:\\s*(?<currentValue>\\S+)"
			],
			"extractVersionTemplate": "^cli-(?<version>.+)$"
		},
		{
			"customType": "regex",
			"managerFilePatterns": [
				"/^packages/web/convex/boxes/infra/runtimeArtifacts\\.ts$/"
			],
			"matchStrings": [
				"//\\s*renovate:\\s*datasource=(?<datasource>docker)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*export const CADDY_IMAGE =\\s*\\n\\s*\"caddy:(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
			]
		}
	]
}
