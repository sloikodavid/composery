{
	"name": "composery",
	"version": "0.1.0",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
	"engines": {
		"node": ">=24.18.0 <25"
	},
	"scripts": {
		"dev": "concurrently -n tree,docker,convex,next,mobile,colors -c green,blue,yellow,yellow,magenta,cyan \"pnpm dev:tree\" \"pnpm dev:docker\" \"pnpm dev:convex\" \"pnpm dev:next\" \"pnpm dev:mobile\" \"pnpm dev:colors\"",
		"dev:next": "pnpm --filter web dev:next",
		"dev:convex": "pnpm --filter web dev:convex",
		"dev:mobile": "pnpm --filter mobile dev",
		"dev:docker": "docker compose --progress=plain -f compose.dev.yml up --build",
		"dev:tree": "node scripts/tree.mjs --watch",
		"dev:colors": "pnpm --filter shared dev:colors",
		"check": "pnpm check:portable && pnpm check:knip && pnpm check:coverage && pnpm check:cli && pnpm check:mutants && pnpm check:renovate",
		"check:portable": "pnpm check:types && pnpm check:lint && pnpm check:format && pnpm check:test && pnpm check:tree && pnpm check:runbook && pnpm check:ide && pnpm check:shared && pnpm check:native-config",
		"check:types": "tsc --noEmit && pnpm -r --if-present run check:types",
		"check:lint": "eslint . --max-warnings 0 && pnpm -r --if-present run check:lint",
		"check:format": "prettier --check .",
		"check:test": "vitest run --coverage",
		"check:tree": "node scripts/tree.mjs",
		"check:runbook": "node scripts/runbook.mjs",
		"check:renovate": "pnpm dlx --package renovate renovate-config-validator renovate.json",
		"check:ide": "pnpm --filter ide check",
		"check:cli": "node scripts/cli.mjs",
		"check:shared": "pnpm --filter shared check",
		"check:native-config": "pnpm --filter mobile check:native-config",
		"fix": "pnpm fix:tree && pnpm fix:runbook && pnpm fix:lint && pnpm fix:format && pnpm fix:cli",
		"fix:tree": "node scripts/tree.mjs --write",
		"fix:runbook": "node scripts/runbook.mjs --write",
		"fix:lint": "eslint . --fix && pnpm -r --if-present run fix:lint",
		"fix:format": "prettier --write .",
		"fix:cli": "node scripts/cli.mjs --fix",
		"build": "pnpm build:web && pnpm build:mobile && pnpm build:docker",
		"build:web": "pnpm --filter web build",
		"build:mobile": "pnpm --filter mobile build",
		"build:docker": "docker compose --progress=plain -f compose.dev.yml build",
		"smoke": "node tests/system/smoke.mjs",
		"templates:schema": "node tests/system/templates/run.mjs schemas",
		"templates:compose": "node tests/system/templates/run.mjs compose",
		"assets": "pnpm --filter shared build",
		"setup": "node scripts/setup.mjs",
		"check:coverage": "node scripts/coverage.mjs",
		"check:knip": "knip",
		"check:mutants": "node scripts/mutants.mjs"
	},
	"prettier": {
		"useTabs": true,
		"trailingComma": "none"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@types/jsdom": "^28.0.3",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"ajv": "^8.20.0",
		"concurrently": "catalog:",
		"eslint": "catalog:",
		"fast-check": "^4.9.0",
		"jsdom": "^29.1.1",
		"knip": "^6.29.0",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "8.65.0",
		"vitest": "catalog:",
		"yaml": "^2.9.0"
	}
}
