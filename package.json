{
	"name": "composery",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "bun --parallel \"dev:*\"",
		"dev:convex": "convex dev",
		"dev:next": "next dev",
		"start": "next start",
		"check": "bun --parallel --no-exit-on-error \"check:*\"",
		"check:characters": "bun scripts/characters.ts check",
		"check:biome": "biome check --error-on-warnings",
		"check:contracts": "tsc --noEmit --project contracts/tsconfig.json",
		"check:convex": "tsc --noEmit --project convex/tsconfig.json",
		"check:scripts": "tsc --noEmit --project scripts/tsconfig.json",
		"check:tests": "tsc --noEmit --project tests/tsconfig.json",
		"check:types": "next typegen && tsc --noEmit",
		"contracts": "bun scripts/contracts.ts",
		"fix": "bun --sequential --no-exit-on-error \"fix:*\"",
		"fix:characters": "bun scripts/characters.ts fix",
		"fix:biome": "biome check --write",
		"verify": "bun check && bun test && next build",
		"research:import": "bun scripts/research/import.ts",
		"session:import": "bun scripts/sessions/import.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"@clerk/backend": "3.17.2",
		"@clerk/nextjs": "7.9.2",
		"@convex-dev/rate-limiter": "0.3.2",
		"@convex-dev/workpool": "0.4.11",
		"clsx": "2.1.1",
		"convex": "1.45.0",
		"next": "16.3.5",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"ssh2": "1.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@tailwindcss/postcss": "4.3.3",
		"@types/bun": "1.4.2",
		"@types/node": "24.13.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ssh2": "1.15.6",
		"babel-plugin-react-compiler": "1.0.0",
		"fflate": "0.8.3",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "24.x"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
