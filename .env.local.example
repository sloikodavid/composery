# What the app reads. The values here are placeholders in the right shape: nothing answers at these
# addresses. `bunx convex dev` and `bunx clerk env pull` overwrite them in your own `.env.local`,
# and CI copies this file as it is, because the checks and the build read the app's configuration.
CONVEX_DEPLOYMENT=local:example
NEXT_PUBLIC_CONVEX_URL=https://example.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://example.convex.site
# See `docs/setups/clerk.md`. Link the application with `bunx clerk link`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_example
CLERK_FRONTEND_API_URL=https://example.clerk.accounts.dev

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
