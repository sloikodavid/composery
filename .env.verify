# The values `bun verify` needs to build the app, and nothing else. They are placeholders: no
# deployment answers at these addresses, and the tests build their own. CI copies this to
# `.env.local`; a person can do the same to reproduce a CI failure.
CONVEX_DEPLOYMENT=local:verify
NEXT_PUBLIC_CONVEX_URL=https://verify.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://verify.convex.site
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dmVyaWZ5LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_verify_never_reaches_clerk
CLERK_FRONTEND_API_URL=https://verify.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1
