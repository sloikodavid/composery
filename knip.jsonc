// Dead-code and unused-dependency gate. Agents leave orphans faster than anyone
// notices them, so this is the rot control the test suite cannot provide.
//
// JSONC rather than JSON: knip 6 rejects unknown keys, so there is nowhere in a
// plain .json file to say why an entry exists - and an ignore list without
// reasons is one nobody can ever safely shrink.
//
// ignoreDependencies holds tools reached other than by import: shadcn is a CLI,
// tailwindcss and tw-animate-css are consumed from CSS
// that knip does not follow, and sharp/png-to-ico/fontkit are used by the shared
// asset generators through dynamic requires. @vscode/codicons and lucide-static
// are read as files rather than imported - the colour console serves
// `node_modules/@vscode/codicons/dist/codicon.css` and
// `node_modules/lucide-static/sprite.svg` over HTTP, and its invariants test
// reads the same codicon CSS to prove every glyph the IDE preview draws is a
// real one. A path in a string is exactly what a static scan cannot follow.
{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.mjs",
				"tests/**/*.test.ts",
				// Both vitest configs are entry points. The mutation one is reached by
				// name from `stryker.config.json` rather than by an import, which is
				// the same blind spot the ignoreDependencies note above describes: a
				// path in a string is what a static scan cannot follow.
				"vitest.config.ts",
				"vitest.mutation.config.ts",
				"eslint.config.mjs"
			],
			"project": ["scripts/**/*.mjs", "tests/**/*.ts", "*.ts", "*.mjs"]
		},
		"packages/shared": {
			"entry": ["index.ts", "scripts/**/*.mjs"],
			"project": ["**/*.{ts,mjs}"]
		},
		"packages/web": {
			"entry": [
				"proxy.ts",
				"convex/**/*.ts",
				"tests/**/*.test.ts",
				"scripts/**/*.mjs",
				"source.config.ts",
				"next.config.ts"
			],
			"project": ["**/*.{ts,tsx}", "scripts/**/*.mjs"],
			"ignore": ["convex/_generated/**", ".source/**"]
		},
		"packages/ide": {
			"entry": ["tests/**/*.test.ts", "scripts/*.mjs"],
			"project": ["tests/**/*.ts", "scripts/*.mjs"]
		}
	},
	"ignore": [
		"packages/ide/overlay/**",
		"packages/ide/upstream/**",
		"packages/web/components/base/**"
	],
	"ignoreDependencies": [
		"@vscode/codicons",
		"lucide-static",
		"sharp",
		"png-to-ico",
		"fontkit",
		"shadcn",
		"tailwindcss",
		"tw-animate-css"
	],
	"ignoreBinaries": ["docker", "cargo", "quilt", "adb"]
}
