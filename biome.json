{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!convex/_generated", "!contracts/*/contract.json"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"next": "recommended",
			"react": "recommended",
			"project": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": "error",
				"useMaxParams": "error"
			},
			"correctness": {
				"noBeforeInteractiveScriptOutsideDocument": "error",
				"noNextAsyncClientComponent": "error"
			},
			"performance": {
				"noBarrelFile": "error",
				"noSyncScripts": "error",
				"useTopLevelRegex": "error"
			},
			"style": {
				"noMagicNumbers": "error",
				"noNestedTernary": "error",
				"noUnusedTemplateLiteral": "error",
				"useBlockStatements": "error",
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": { "style": "type" }
				},
				"useExplicitLengthCheck": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				},
				"useNamingConvention": {
					"level": "error",
					"options": {
						"conventions": [
							{
								"selector": { "kind": "const", "scope": "global" },
								"formats": ["camelCase"]
							}
						]
					}
				},
				"useNumericSeparators": "error"
			},
			"suspicious": {
				"noShadow": "error",
				"noUnnecessaryConditions": "error",
				"useAwait": "error",
				"useErrorMessage": "error"
			},
			"nursery": {
				"noComponentHookFactories": "error",
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useExhaustiveSwitchCases": "error",
				"useReactCompiler": "error",
				"useSortedClasses": "info"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["convex/**", "tests/convex/**"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": {
							"level": "error",
							"options": { "filenameCases": ["snake_case"] }
						}
					}
				}
			}
		}
	]
}
