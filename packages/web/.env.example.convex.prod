# Clerk - secret key, production instance, same value as the Next CLERK_SECRET_KEY.
# Read here for staff-triggered account deletion via the Clerk Backend API
# (convex/accountDeletion.ts)
CLERK_SECRET_KEY=

# Clerk - Frontend API URL, production instance (dashboard.clerk.com -> API keys)
CLERK_FRONTEND_API_URL=

# Clerk - webhook signing secret for /clerk/events (dashboard.clerk.com -> Webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=

# Domains
WEBSITE_ORIGIN=https://www.composery.io

CLOUD_DOMAIN=composery.cloud

# Polar Production - polar.sh
POLAR_ORGANIZATION_TOKEN=

POLAR_WEBHOOK_SECRET=

POLAR_BOX_AIR_MONTHLY_PRODUCT_ID=

POLAR_BOX_AIR_ANNUAL_PRODUCT_ID=

POLAR_BOX_PRO_MONTHLY_PRODUCT_ID=

POLAR_BOX_PRO_ANNUAL_PRODUCT_ID=

POLAR_ENVIRONMENT=production

# Hetzner - console.hetzner.cloud
HETZNER_CLOUD_TOKEN=

HETZNER_BOX_LOCATIONS=nbg1,fsn1,hel1

HETZNER_BOX_IMAGE=docker-ce

# Key name or numeric id from the project SSH keys, comma-separated for multiple
HETZNER_SSH_KEYS=

# Hypervisor-level allowlist every box gets: inbound TCP 22/80/443 from anywhere,
# nothing else inbound, no outbound rules. See docs/developing/web/services/hetzner.md
HETZNER_FIREWALL_ID=

# Optional. Leave empty: shared Hetzner private networks bypass the firewall
HETZNER_NETWORK_ID=

# Cloudflare - dash.cloudflare.com (DNS edit token + zone id)
CLOUDFLARE_DNS_TOKEN=

CLOUDFLARE_ZONE_ID=

# Runtime container
RUNTIME_IMAGE=ghcr.io/sloikodavid/composery:latest

RUNTIME_PORT=8080

# Box SSH access (whole lifecycle, not just bootstrap)
SSH_USER=root

SSH_PRIVATE_KEY=

# Resend - resend.com (required for production alert and owner-notice delivery)
RESEND_API_KEY=

RESEND_WEBHOOK_SECRET=

# Verified website-domain sender for staff alerts
ALERT_EMAIL_FROM=

# Verified website-domain sender for box owner notices. A customer-facing
# address on the same verified subdomain, kept apart from the alert sender so
# what an owner sees, and what they reply to, is not the incident inbox.
OWNER_EMAIL_FROM=
