{
	"compilerOptions": {
		// ES2020 rather than Next's scaffolded ES2017, because a Convex component
		// registered by the test harness (`@convex-dev/workpool`, pulled in by
		// `@convex-dev/workflow/test`) ships TypeScript sources that use BigInt
		// literals. Nothing shipped changes: `noEmit` is set here and `next build`
		// compiles with SWC against its own browser targets, so this only decides
		// what the checker is willing to read.
		"target": "ES2020",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./*"],
			"collections/*": ["./.source/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	"exclude": ["node_modules"]
}
