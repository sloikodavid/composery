@@ -669,8 +669,15 @@ document.addEventListener('click', event
 			let hrefText = node.getAttribute('data-href');
 			if (!hrefText) {
 				hrefText = node.getAttribute('href');
-				// Pass through known schemes
-				if (hrefText && passThroughLinkSchemes.some(scheme => hrefText!.startsWith(scheme))) {
+				if (hrefText && /^(?:https?):/i.test(hrefText)) {
+					messaging.postMessage('openLink', { href: hrefText });
+					event.preventDefault();
+					event.stopPropagation();
+					return;
+				}
+
+				// Schemes that do not need workbench validation retain their native behavior.
+				if (hrefText && passThroughLinkSchemes.some(scheme => hrefText!.startsWith(scheme))) {
 					return;
 				}
 			}
