 	border-color: var(--vscode-checkbox-border) !important;
 }
+
+/* Composery: a finger pans the welcome scrollables natively. DomScrollableElement scrolls
+ * the real element (scrollTop) and reads it back on scanDomNode, and gettingStarted.ts
+ * mirrors native scrolls into the widget - so opting the elements into native overflow is
+ * the whole touch story, and every click in the page stays a plain browser click (a
+ * Gesture-target here suppressed them all). !important beats the widget's inline
+ * `overflow: hidden`; the custom (hidden) scrollbar stays the only visible one. */
+@media (hover: none), (any-pointer: coarse) {
+	.monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedSlideCategories,
+	.monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedDetailsContent,
+	.monaco-workbench .part.editor > .content .gettingStartedContainer .getting-started-detail-container {
+		overflow-y: auto !important;
+		touch-action: pan-y;
+		scrollbar-width: none;
+	}
+}
+
+/* Composery: slight hover on the welcome agent cards (their base styles are inline in welcome.diff). */
+.composery-agent {
+	transition: background-color 0.1s ease;
+}
+
+.composery-agent:hover {
+	background-color: var(--vscode-list-hoverBackground);
+}
+
+/* Composery: code-server's custom card is prepended into an upstream grid column that is normally
+ * clipped to the editor height. When the agent setup card is present, let that grid grow so the
+ * page-level DomScrollableElement gets a real scroll range for wheel, scrollbar and touch input. */
+.monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedSlideCategories > .gettingStartedCategoriesContainer:has(.composery-agent-category) {
+	height: auto;
+	min-height: 100%;
+}
+
+.monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedSlideCategories > .gettingStartedCategoriesContainer:has(.composery-agent-category) > .categories-column {
+	overflow: visible;
+}
