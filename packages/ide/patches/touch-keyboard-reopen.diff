+	// Composery: Android Chrome re-opens a dismissed on-screen keyboard whenever a touch
+	// gesture ends while an editable still holds focus - and the terminal and the editor
+	// both keep a hidden textarea focused the whole time. So panning either one with the
+	// keyboard down popped it straight back up, and the resize that followed ate the pan
+	// (device-verified 2026-07-20). inputmode="none" is the only thing that stands that
+	// re-open down; it does not close a keyboard that is already up and does not touch key
+	// handling, so a pan can set it unconditionally. allowKeyboardReopen puts it back on
+	// the next tap - the gesture that actually asks to type.
+	private suppressKeyboardReopen(target: EventTarget | undefined): void {
+		if (this.keyboardSuppressed || !(target instanceof Node)) {
+			return;
+		}
+		const active = target.ownerDocument?.activeElement;
+		if (!(active instanceof HTMLElement) || !DomUtils.isEditableElement(active)) {
+			return;
+		}
+		this.keyboardSuppressed = { element: active, inputMode: active.getAttribute('inputmode') };
+		active.setAttribute('inputmode', 'none');
+	}
+
+	private allowKeyboardReopen(): void {
+		if (!this.keyboardSuppressed) {
+			return;
+		}
+		const { element, inputMode } = this.keyboardSuppressed;
+		this.keyboardSuppressed = undefined;
+		if (inputMode === null) {
+			element.removeAttribute('inputmode');
+		} else {
+			element.setAttribute('inputmode', inputMode);
+		}
+	}
+
