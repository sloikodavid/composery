+/*---------------------------------------------------------------------------------------------
+ * Composery: conditional terminal grid anchoring on touch - terminalTouchAnchor.ts toggles
+ * the class. Upstream bottom-aligns the grid (terminal.css), which shifts short buffers by
+ * the row-fit remainder whenever the on-screen keyboard toggles the pane height.
+ *--------------------------------------------------------------------------------------------*/
+
+.monaco-workbench .terminal-editor .terminal-wrapper.composery-terminal-top-anchor .xterm,
+.monaco-workbench .pane-body.integrated-terminal .terminal-wrapper.composery-terminal-top-anchor .xterm {
+	/* Pin to the stable pane top while content has not reached the bottom row. */
+	top: 0;
+	bottom: auto;
+}
