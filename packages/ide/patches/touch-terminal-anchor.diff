+/*---------------------------------------------------------------------------------------------
+ * Composery: on touch devices the on-screen keyboard toggles the terminal pane between two
+ * heights, and upstream's bottom-aligned grid (terminal.css) sits under a top gap of
+ * height-mod-cell-height that differs between those heights - so a buffer that has not
+ * filled the viewport visibly jumps by a sub-line amount on every keyboard open/close.
+ * Anchor the grid to the stable pane top until content reaches the bottom row; from then
+ * on (or while an alternate-screen app owns the grid) upstream's bottom alignment is right:
+ * it keeps the active row flush above the keybar through the same height toggles.
+ *--------------------------------------------------------------------------------------------*/
+
+import type { Terminal as RawXtermTerminal } from '@xterm/xterm';
+import './media/terminalTouchAnchor.css';
+import { getWindow } from '../../../../base/browser/dom.js';
+import { isTouch } from '../../../../base/browser/touchGate.js';
+import { DisposableStore, IDisposable } from '../../../../base/common/lifecycle.js';
+
+export function trackTerminalTopAnchor(raw: RawXtermTerminal, wrapperElement: HTMLElement): IDisposable {
+	const store = new DisposableStore();
+	if (!isTouch(getWindow(wrapperElement))) {
+		return store;
+	}
+	const update = () => {
+		const buffer = raw.buffer.active;
+		const reachedBottom = buffer.type === 'alternate' || buffer.baseY > 0 || buffer.cursorY >= raw.rows - 1;
+		wrapperElement.classList.toggle('composery-terminal-top-anchor', !reachedBottom);
+	};
+	store.add(raw.onWriteParsed(update));
+	store.add(raw.onResize(update));
+	store.add(raw.buffer.onBufferChange(update));
+	update();
+	return store;
+}
