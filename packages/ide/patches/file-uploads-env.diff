Composery is configured entirely by environment variables, but upstream wires only
three of its four feature toggles to one: --disable-file-uploads stays CLI-only, and
no Composery deployment passes CLI flags. Give it the env var its siblings already
have, so the COMPOSERY_DISABLE_FILE_UPLOADS documented in docs/configuration.md
takes effect.

--- a/src/node/cli.ts
+++ b/src/node/cli.ts
@@ -617,6 +617,10 @@
     args["disable-file-downloads"] = true
   }
 
+  if (process.env.COMPOSERY_DISABLE_FILE_UPLOADS?.match(/^(1|true)$/)) {
+    args["disable-file-uploads"] = true
+  }
+
   if (process.env.COMPOSERY_DISABLE_GETTING_STARTED_OVERRIDE?.match(/^(1|true)$/)) {
     args["disable-getting-started-override"] = true
   }
