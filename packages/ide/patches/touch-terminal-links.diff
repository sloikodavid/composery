+	// Composery: touch link activation - a tap carries no modifier, so resolve the link
+	// covering the tapped cell and open it through the same modifier-exempt path as the
+	// link quick pick. Word links (workspace search) stay tap-inert on purpose: nearly
+	// every cell holds a word, and a tap must keep meaning "focus the terminal".
+	async openLinkAt(clientX: number, clientY: number): Promise<boolean> {
+		interface XtermWithCore extends Terminal {
+			_core: IXtermCore;
+		}
+		const cell = (this._xterm as XtermWithCore)._core._renderService.dimensions.css.cell;
+		const screen = this._xterm.element?.querySelector('.xterm-screen');
+		if (!screen || cell.width <= 0 || cell.height <= 0) {
+			return false;
+		}
+		const rect = screen.getBoundingClientRect();
+		const x = Math.floor((clientX - rect.left) / cell.width) + 1;
+		const row = Math.floor((clientY - rect.top) / cell.height) + 1;
+		if (x < 1 || x > this._xterm.cols || row < 1 || row > this._xterm.rows) {
+			return false;
+		}
+		const y = this._xterm.buffer.active.viewportY + row;
+		for (const type of ['url', 'localFile', 'localFolder'] as const) {
+			const links = await this._getLinksForType(y, type);
+			const link = links?.find(l =>
+				y >= l.range.start.y && y <= l.range.end.y &&
+				(y > l.range.start.y || x >= l.range.start.x) &&
+				(y < l.range.end.y || x <= l.range.end.x));
+			if (link) {
+				link.activate(new TerminalLinkQuickPickEvent(EventType.CLICK), link.text);
+				return true;
+			}
+		}
+		return false;
+	}
