+	private addShowQrCommand() {
+		const targetWindow = window.top || window;
+		const instanceUrl = new URL(this.productService.rootEndpoint || '.', targetWindow.location.href).href;
+		const { hostname, protocol } = new URL(instanceUrl);
+		const normalizedHostname = hostname.toLowerCase().replace(/\.$/, '');
+		const isLoopback = normalizedHostname === 'localhost'
+			|| normalizedHostname.endsWith('.localhost')
+			|| normalizedHostname.startsWith('127.')
+			|| normalizedHostname === '[::1]';
+		const isUnspecified = normalizedHostname === '0.0.0.0'
+			|| normalizedHostname === '[::]';
+		if (!['http:', 'https:'].includes(protocol) || isLoopback || isUnspecified) {
+			return;
+		}
