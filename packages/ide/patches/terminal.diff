+	attach(id: number, clientId: string, makeController: boolean, streaming: boolean = false): void {
+		let clients = this._clients.get(id);
+		if (!clients) {
+			clients = new Set();
+			this._clients.set(id, clients);
+		}
+		clients.add(clientId);
+		let clientAcknowledged = this._clientAcknowledged.get(id);
+		if (!clientAcknowledged) {
+			clientAcknowledged = new Map();
+			this._clientAcknowledged.set(id, clientAcknowledged);
+		}
+		clientAcknowledged.set(clientId, this._acknowledged.get(id) ?? 0);
+		if (makeController || !this._controllers.has(id)) {
+			this._controllers.set(id, clientId);
+		}
+		if (streaming) {
+			this.markStreaming(id, clientId);
+		}
+	}
+
+	detach(id: number, clientId: string): { attached: boolean; final: boolean; nextController?: string; dimensions?: IClientDimensions } {
+		const clients = this._clients.get(id);
+		if (!clients?.delete(clientId)) {
+			return { attached: false, final: false };
+		}
+		this._dimensions.get(id)?.delete(clientId);
+		this._clientAcknowledged.get(id)?.delete(clientId);
+		this._streaming.get(id)?.delete(clientId);
+		if (!clients.size) {
+			this.clear(id);
+			return { attached: true, final: true };
+		}
+		if (this._controllers.get(id) !== clientId) {
+			return { attached: true, final: false };
+		}
+		const nextController = clients.values().next().value as string;
+		this._controllers.set(id, nextController);
+		return { attached: true, final: false, nextController, dimensions: this._dimensions.get(id)?.get(nextController) };
+	}
+
+	detachClient(clientId: string): { id: number; final: boolean; dimensions?: IClientDimensions }[] {
+		const detached: { id: number; final: boolean; dimensions?: IClientDimensions }[] = [];
+		for (const id of [...this._clients.keys()]) {
+			if (this._clients.get(id)?.has(clientId)) {
+				const result = this.detach(id, clientId);
+				detached.push({ id, final: result.final, dimensions: result.dimensions });
+			}
+		}
+		return detached;
+	}
+
+	isAttached(id: number, clientId: string): boolean { return this._clients.get(id)?.has(clientId) ?? false; }
+	isController(id: number, clientId: string): boolean { return this._controllers.get(id) === clientId; }
+	isStreaming(id: number, clientId: string): boolean { return this._streaming.get(id)?.has(clientId) ?? false; }
+
+	markStreaming(id: number, clientId: string): void {
+		if (!this.isAttached(id, clientId)) {
+			return;
+		}
+		let streamingClients = this._streaming.get(id);
+		if (!streamingClients) {
+			streamingClients = new Set();
+			this._streaming.set(id, streamingClients);
+		}
+		streamingClients.add(clientId);
+	}
+
+	recordDimensions(id: number, clientId: string, dimensions: IClientDimensions): boolean {
+		if (!this.isAttached(id, clientId)) {
+			return false;
+		}
+		let byClient = this._dimensions.get(id);
+		if (!byClient) {
+			byClient = new Map();
+			this._dimensions.set(id, byClient);
+		}
+		byClient.set(clientId, dimensions);
+		return this.isController(id, clientId);
+	}
+
+	takeControl(id: number, clientId: string): IClientDimensions | undefined {
+		if (!this.isAttached(id, clientId) || this.isController(id, clientId)) {
+			return undefined;
+		}
+		this._controllers.set(id, clientId);
+		return this._dimensions.get(id)?.get(clientId);
+	}
+
+	acknowledge(id: number, clientId: string, charCount: number): number {
+		if (!this.isAttached(id, clientId) || charCount <= 0) {
+			return 0;
+		}
+		const byClient = this._clientAcknowledged.get(id)!;
+		const clientTotal = (byClient.get(clientId) ?? this._acknowledged.get(id) ?? 0) + charCount;
+		byClient.set(clientId, clientTotal);
+		const acknowledged = this._acknowledged.get(id) ?? 0;
+		const delta = Math.max(clientTotal - acknowledged, 0);
+		if (delta) {
+			this._acknowledged.set(id, clientTotal);
+		}
+		return delta;
+	}
+
+	clear(id: number): void {
+		this._clients.delete(id);
+		this._controllers.delete(id);
+		this._dimensions.delete(id);
+		this._acknowledged.delete(id);
+		this._clientAcknowledged.delete(id);
+		this._streaming.delete(id);
+	}
