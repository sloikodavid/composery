+++ b/lib/vscode/src/vs/code/browser/workbench/workbench.html
@@ -10,7 +10,10 @@
 		<!-- Mobile tweaks -->
 		<meta name="mobile-web-app-capable" content="yes" />
 		<meta name="apple-mobile-web-app-capable" content="yes" />
-		<meta name="apple-mobile-web-app-title" content="Code">
+		<meta name="apple-mobile-web-app-title" content="Composery">
+		<!-- Status bar tint for an installed app. The manifest carries one colour for the splash; these track the scheme the workbench itself starts in (window.autoDetectColorScheme). -->
+		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
+		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
 		<link rel="apple-touch-icon" sizes="192x192" href="{{BASE}}/_static/src/browser/media/pwa-icon-192.png" />
