COMPOSERY_DISABLE_AUTH turns sign-in off for deployments that put their own gate
in front of the IDE (a private network, an SSO proxy, a throwaway local box).
Upstream already carries AuthType.None end to end - authenticated() short-circuits
so the workbench, both proxies and every websocket open together, and the Sign Out
and Change Password commands drop out of the menu with the endpoints behind them -
so the switch only has to select it over the shipped `auth: password` config. The
boot line becomes a warning that names the real exposure, and a cloud box sits on
the public internet where a self-hosted one may be loopback-only.

--- a/src/node/cli.ts
+++ b/src/node/cli.ts
@@ -593,6 +593,13 @@
     args.auth = AuthType.Password
   }
 
+  // Overrides the config file, which ships `auth: password`, so the switch
+  // works without editing config. Only 1/true disable sign-in: every other
+  // value, typos included, has to fail towards keeping the instance protected.
+  if (process.env.COMPOSERY_DISABLE_AUTH?.match(/^(1|true)$/)) {
+    args.auth = AuthType.None
+  }
+
   const addr = bindAddrFromAllSources(configArgs || {}, cliArgs)
   args.host = addr.host
   args.port = addr.port
