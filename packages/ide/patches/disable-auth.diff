+    // Config can also select `auth: none`, so name both ways back.
+    const reach = process.env.COMPOSERY_CLOUD_BOX_ID
+      ? "this box is published on the internet, so anyone who learns its address"
+      : "anyone who can reach it"
+    logger.warn(
