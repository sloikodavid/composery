+	//#region Composery narrow-viewport fullscreen parts
+
+	// On a narrow touch viewport exactly one of the side bar / panel / secondary side bar is open at
+	// a time and fills the screen by collapsing the editor beneath it - the setEditorHidden(true)
+	// trick native panel/aux maximize uses, so it reads as a true 1:1 fullscreen with no grid-resize
+	// math; closing the open part reveals the editor again. editorHiddenForNarrowPart records that WE
+	// collapsed the editor: it relaxes the editor/panel "both hidden" invariant in setEditorHidden and
+	// keeps isPanelMaximized()/focusPanelOrEditor() from treating the hidden editor as a maximized panel.
+	//
+	// Modeled on native maximize (setAuxiliaryBarMaximized): every part mutation happens synchronously
+	// inside inNarrowPartTransition, which the part-visibility relay skips reacting to, so there is no
+	// re-entrant cascade. The open part is tracked as explicit intent (narrowPart), not
+	// re-read from transient visibility - so when queued visibility events drain after the transition,
+	// applyNarrowLayout sees the same intent, finds the state already correct, and converges instead
+	// of oscillating.
+	private static readonly NARROW_PARTS = [Parts.SIDEBAR_PART, Parts.PANEL_PART, Parts.AUXILIARYBAR_PART];
+	private inNarrowPartTransition = false;
+	private editorHiddenForNarrowPart = false;
+	private narrowPart: Parts | undefined;
+	private narrowLayoutInitialized = false;
+	private readonly narrowLayoutScheduler = this._register(new RunOnceScheduler(() => this.applyNarrowLayout(), 0));
+	private desktopPartVisibility: Set<Parts> | undefined;
+
+	private get isNarrowViewport(): boolean {
+		return isNarrow(mainWindow);
+	}
+
+	// A content part opened -> it becomes the fullscreen one; the open part closing -> none is. Either
+	// way re-apply, so opening any part also closes the previous one and collapses the editor.
+	private onContentPartVisibility(part: Parts, visible: boolean): void {
+		if (this.inNarrowPartTransition) {
+			return;
+		}
+
+		if (visible) {
+			this.narrowPart = part;
+		} else if (part === this.narrowPart) {
+			this.narrowPart = undefined;
+		}
+		this.scheduleNarrowLayout();
+	}
+
+	private scheduleNarrowLayout(): void {
+		this.narrowLayoutScheduler.schedule();
+	}
+
+	private applyNarrowLayout(): void {
+		if (!this.workbenchGrid) {
+			return;
+		}
+		if (this.inNarrowPartTransition || this.inMaximizedAuxiliaryBarTransition) {
+			this.scheduleNarrowLayout();
+			return;
+		}
+		this.inNarrowPartTransition = true;
+		try {
+			if (!this.isNarrowViewport) {
+				this.restoreDesktopPartVisibility();
+				return;
+			}
+			this.desktopPartVisibility ??= new Set(Layout.NARROW_PARTS.filter(part => this.isVisible(part)));
+			const keep = (this.narrowPart !== undefined && this.isVisible(this.narrowPart))
+				? this.narrowPart
+				: undefined;
+			// Exclusivity: at most one content part stays open.
+			let changed = false;
+			for (const part of Layout.NARROW_PARTS) {
+				if (part !== keep && this.isVisible(part)) {
+					this.setPartHidden(true, part);
+					changed = true;
+				}
+			}
+			// Fullscreen: collapse the editor beneath the open part, or reveal it once none is open.
+			if (keep !== undefined) {
+				this.editorHiddenForNarrowPart = true;
+				if (this.isVisible(Parts.EDITOR_PART)) {
+					this.setEditorHidden(true);
+					changed = true;
+				}
+				// Hiding the siblings/editor routes focus to the now-collapsed editor, leaving the
+				// fullscreened part (e.g. the terminal) unfocused - so on touch the on-screen keyboard
+				// never opens. Re-focus the open part, exactly as native maximize does (setAuxiliaryBarMaximized).
+				if (changed) {
+					// keep is always one of NARROW_PARTS (side bar / panel / secondary side bar),
+					// all single-window parts - same cast VS Code uses on this trio elsewhere.
+					this.focusPart(keep as SINGLE_WINDOW_PARTS);
+				}
+			} else {
+				this.revealEditorFromNarrowPart();
+			}
+		} finally {
+			this.inNarrowPartTransition = false;
+		}
+	}
+
+	private revealEditorFromNarrowPart(): void {
+		if (this.editorHiddenForNarrowPart) {
+			this.editorHiddenForNarrowPart = false;
+			if (!this.isVisible(Parts.EDITOR_PART)) {
+				this.setEditorHidden(false);
+			}
+		}
+	}
+
+	private restoreDesktopPartVisibility(): void {
+		this.revealEditorFromNarrowPart();
+		if (!this.desktopPartVisibility) {
+			return;
+		}
+		// Preserve the part the user selected while narrow when rotating wide; the snapshot restores
+		// the surrounding desktop layout, while the selected part remains the user's current context.
+		const desktopPartVisibility = new Set(this.desktopPartVisibility);
+		if (this.narrowPart !== undefined) {
+			desktopPartVisibility.add(this.narrowPart);
+		}
+		for (const part of Layout.NARROW_PARTS) {
+			this.setPartHidden(!desktopPartVisibility.has(part), part);
+		}
+		this.desktopPartVisibility = undefined;
+	}
+
+	//#endregion
