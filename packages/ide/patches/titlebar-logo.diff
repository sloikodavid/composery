+/* Composery: outside our own themes, render the title-bar logo monochrome in the theme's
+   button accent colour (via mask) so it doesn't clash with third-party themes. */
+.monaco-workbench:not(.composery-theme) .part.titlebar > .titlebar-container > .titlebar-left > .window-appicon:not(.codicon) {
+	background-image: none;
+	background-color: var(--vscode-button-background, var(--vscode-activityBarBadge-background, var(--vscode-titleBar-activeForeground, var(--vscode-foreground))));
