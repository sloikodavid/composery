+	private registerTouchScroll(element: HTMLElement, getScrollbar: () => DomScrollableElement | undefined) {
+		const disposables = new DisposableStore();
+		disposables.add(Gesture.addTarget(element));
+		disposables.add(addDisposableListener(element, TouchEventType.Change, event => {
+			event.preventDefault();
+			event.stopPropagation();
+			const scrollbar = getScrollbar();
+			if (!scrollbar) {
+				return;
+			}
+			const scrollPosition = scrollbar.getScrollPosition();
+			scrollbar.setScrollPosition({ scrollLeft: scrollPosition.scrollLeft - event.translationX, scrollTop: scrollPosition.scrollTop - event.translationY });
+		}));
+		return disposables;
+	}
