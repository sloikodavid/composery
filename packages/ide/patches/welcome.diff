 .monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedSlide .getting-started-checkbox {
 	border-color: var(--vscode-checkbox-border) !important;
 }
+
+/* Composery: slight hover on the welcome agent cards (their base styles are inline in welcome.diff). */
+.composery-agent {
+	transition: background-color 0.1s ease;
+}
+
+.composery-agent:hover {
+	background-color: var(--vscode-list-hoverBackground);
+}
+
+/* Composery: code-server's custom card is prepended into an upstream grid column that is normally
+ * clipped to the editor height. When the agent setup card is present, let that grid grow so the
+ * page-level DomScrollableElement gets a real scroll range for wheel, scrollbar and touch input. */
+.monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedSlideCategories > .gettingStartedCategoriesContainer:has(.composery-agent-category) {
+	height: auto;
+	min-height: 100%;
+}
+
+.monaco-workbench .part.editor > .content .gettingStartedContainer .gettingStartedSlideCategories > .gettingStartedCategoriesContainer:has(.composery-agent-category) > .categories-column {
