+	private isInNativeSelectionZone(target: EventTarget): boolean {
+		if (!(target instanceof Node)) {
+			return false;
+		}
+		for (const zone of this.nativeSelectionZones) {
+			if (zone.contains(target)) {
+				return true;
+			}
+		}
+		return false;
+	}
