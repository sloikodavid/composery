+	// Composery: the browser draws its selection handles hanging just below the selection's
+	// two edges. A touch landing on one of those spots while a native-zone selection is up
+	// is the browser grabbing a handle - Android still delivers the drag's touch events to
+	// the page, and a single prevented touchmove (or a Gesture pan scrolling the editor
+	// underneath) aborts the drag. Such a touch belongs to the browser: Gesture dispatches
+	// nothing for it and never calls preventDefault. iOS consumes handle drags outright,
+	// so this only ever matches where the events actually arrive.
+	private isOnNativeSelectionHandle(touch: Touch): boolean {
+		const selection = touch.target instanceof Node ? touch.target.ownerDocument?.getSelection() : null;
+		if (!selection || selection.rangeCount === 0 || selection.isCollapsed) {
+			return false;
+		}
+		if (!selection.anchorNode || !this.isInNativeSelectionZone(selection.anchorNode)) {
+			return false;
+		}
+		const rects = selection.getRangeAt(0).getClientRects();
+		if (rects.length === 0) {
+			return false;
+		}
+		const first = rects[0];
+		const last = rects[rects.length - 1];
+		const nearHandle = (x: number, y: number) => Math.abs(touch.clientX - x) <= 32 && touch.clientY >= y - 8 && touch.clientY <= y + 44;
+		return nearHandle(first.left, first.bottom) || nearHandle(last.right, last.bottom);
+	}
