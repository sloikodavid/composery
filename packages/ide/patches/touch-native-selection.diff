+	// Composery: a native-selection zone is a Gesture target whose initial touch must reach
+	// the browser un-prevented, so its long-press text selection (native handles + the OS
+	// toolbar) can start. Gesture still dispatches Start/Change/Tap there, and the tap's
+	// touchend stays prevented, so no compat mouse events are synthesized.
+	public static nativeSelectionZone(element: HTMLElement): IDisposable {
+		if (!Gesture.isTouchDevice()) {
+			return Disposable.None;
+		}
+		if (!Gesture.INSTANCE) {
+			Gesture.INSTANCE = markAsSingleton(new Gesture());
+		}
+
+		const remove = Gesture.INSTANCE.nativeSelectionZones.push(element);
+		return toDisposable(remove);
+	}
