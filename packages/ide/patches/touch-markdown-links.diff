+
+		// Composery: inside a Gesture target (list rows, trees, menus) touchstart is
+		// preventDefaulted and the browser never synthesizes a click, so rendered links
+		// are tap-dead. Becoming a Gesture target ourselves is what routes Tap here;
+		// the suppressed click keeps activation single-fire everywhere else.
+		if (isTouch(DOM.getWindow(outElement))) {
+			disposables.add(Gesture.addTarget(outElement));
+			disposables.add(DOM.addDisposableListener(outElement, TouchEventType.Tap, (e: GestureEvent) => {
+				if (DOM.isHTMLElement(e.initialTarget)) {
+					activateLink(markdown, options, {
+						target: e.initialTarget,
+						preventDefault: () => e.preventDefault(),
+						stopPropagation: () => e.stopPropagation()
+					});
+				}
+			}));
+		}
