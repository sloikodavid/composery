+/*---------------------------------------------------------------------------------------------
+ * Composery Mobile Keybar - docked at the bottom of the terminal view pane on touch devices.
+ * TerminalViewPane reserves its height in layoutBody (see terminalKeybar.ts), so the bar
+ * occupies real layout space: nothing overlaps it and it overlaps nothing. Keys are drawn
+ * as native VS Code keycaps (the .monaco-keybinding-key / keybindingLabel palette).
+ *--------------------------------------------------------------------------------------------*/
+
+.monaco-workbench .integrated-terminal .composery-touch-keybar {
+	position: absolute;
+	left: 0;
+	right: 0;
+	bottom: 0;
+	/* Above the tabbed view's split-view-container, which spans the full pane. */
+	z-index: 10;
+	box-sizing: border-box;
+	/* Height is set by terminalKeybar.ts (KEYBAR_HEIGHT - also reserved in layoutBody). */
+	padding: 0 4px;
+	background-color: var(--vscode-editorWidget-background);
+	border-top: 1px solid var(--vscode-widget-border, var(--vscode-editorWidget-border));
+	overflow: hidden;
+}
+
+.monaco-workbench .integrated-terminal .composery-touch-keybar > .actions-container {
+	display: flex;
+	align-items: stretch;
+	gap: 4px;
+	/* The upstream ul is content-box: without this, height + padding overflows the
+	 * 40px bar and overflow:hidden clips the bottom of the keycaps. */
+	box-sizing: border-box;
+	height: 100%;
+	margin: 0;
+	padding: 4px 0;
+	list-style: none;
+}
+
+/* Full-height keys: the upstream action bar centers items and labels
+ * (.monaco-action-bar .action-item { align-items: center }), which would collapse the
+ * label to its line height - stretch both so the whole keycap is the touch target. */
+.monaco-workbench .integrated-terminal .composery-touch-keybar .action-item {
+	display: flex;
+	align-items: stretch;
+	flex: 1 1 0;
+	min-width: 0;
+}
+
+.monaco-workbench .integrated-terminal .composery-touch-keybar .action-label {
+	display: flex;
+	flex: 1 1 auto;
+	align-items: center;
+	justify-content: center;
+	min-width: 0;
+	padding: 0 2px;
+	border-radius: 3px;
+	background-color: var(--vscode-keybindingLabel-background);
+	color: var(--vscode-keybindingLabel-foreground);
+	border: 1px solid var(--vscode-keybindingLabel-border);
+	border-bottom-color: var(--vscode-keybindingLabel-bottomBorder);
+	box-shadow: inset 0 -1px 0 var(--vscode-widget-shadow);
+	font-size: 12px;
+	white-space: nowrap;
+	/* Keys flex-shrink below label width in a narrow pane - clip instead of spilling out. */
+	overflow: hidden;
+	cursor: pointer;
+	user-select: none;
+	-webkit-user-select: none;
+	touch-action: manipulation;
+}
+
+.monaco-workbench .integrated-terminal .composery-touch-keybar .action-label:active {
+	background-color: var(--vscode-toolbar-activeBackground, var(--vscode-toolbar-hoverBackground));
+}
+
+.monaco-workbench .integrated-terminal .composery-touch-keybar .action-label.checked {
+	color: var(--vscode-inputOption-activeForeground);
+	background-color: var(--vscode-inputOption-activeBackground);
+	border-color: var(--vscode-inputOption-activeBorder, transparent);
+}
+
+/* Locked (double-tapped) modifier - persists until tapped off; underline marks the difference. */
+.monaco-workbench .integrated-terminal .composery-touch-keybar .action-label.locked {
+	text-decoration: underline;
+	text-underline-offset: 3px;
+}
