+/*---------------------------------------------------------------------------------------------
+ * Composery Mobile Keybar: a strip of terminal control / modifier keys docked beneath the
+ * panel terminal on touch devices. TerminalViewPane owns placement: it appends the bar in
+ * renderBody and subtracts its height in layoutBody, so the bar participates in the
+ * workbench's own layout - no overlays, no keyboard-geometry math, no manual terminal
+ * relayout. Dedicated keys send raw pty bytes via ITerminalInstance.sendText (the path
+ * Ctrl+C already uses), and sticky Ctrl/Alt rewrite the next typed character via
+ * beforeinput (robust on Android, where keydown reports keyCode 229). The pane body is a
+ * Gesture target (viewPaneContainer.ts) and Gesture preventDefaults touchstart inside its
+ * targets, which suppresses the browser's synthesized click - so, exactly like the
+ * upstream action bar (actionViewItems.ts), every key is itself a Gesture target and
+ * activates on the Tap gesture event, with plain click kept for mouse. Keys never take
+ * focus: sendText talks straight to the pty, so tapping the bar neither steals the
+ * terminal's focus nor force-opens the on-screen keyboard.
+ *--------------------------------------------------------------------------------------------*/
+
+import './media/terminalKeybar.css';
+import * as dom from '../../../../base/browser/dom.js';
+import { EventType as TouchEventType, Gesture } from '../../../../base/browser/touch.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { isTouch } from '../../../../base/browser/touchGate.js';
+import { ITerminalService } from './terminal.js';
+
+type Modifier = 'ctrl' | 'alt';
+type ModifierState = 'off' | 'oneShot' | 'locked';
+
+const DOUBLE_TAP_MS = 350;
+const KEYBAR_HEIGHT = 40;
+
+interface KeyDef {
+	// Text label or codicon id - exactly one is set.
+	readonly label?: string;
+	readonly icon?: string;
+	readonly title: string;
+	// Bytes for the key; arrows honor sticky modifiers and DECCKM application mode.
+	readonly bytes: (mods: ReadonlySet<Modifier>, applicationCursor: boolean) => string;
+}
+
+function csiArrow(letter: string, mods: ReadonlySet<Modifier>, applicationCursor: boolean): string {
+	const code = mods.has('ctrl') ? 5 : mods.has('alt') ? 3 : 1;
+	if (code !== 1) {
+		return `\x1b[1;${code}${letter}`;
+	}
+	return applicationCursor ? `\x1bO${letter}` : `\x1b[${letter}`;
+}
+
+const CONTROL_KEYS: KeyDef[] = [
+	{ label: 'Esc', title: 'Escape', bytes: () => '\x1b' },
+	{ label: 'Tab', title: 'Tab', bytes: () => '\x09' },
+	{ label: '^C', title: 'Ctrl+C (interrupt)', bytes: () => '\x03' },
+	{ icon: 'arrow-left', title: 'Left', bytes: (mods, app) => csiArrow('D', mods, app) },
+	{ icon: 'arrow-down', title: 'Down', bytes: (mods, app) => csiArrow('B', mods, app) },
+	{ icon: 'arrow-up', title: 'Up', bytes: (mods, app) => csiArrow('A', mods, app) },
+	{ icon: 'arrow-right', title: 'Right', bytes: (mods, app) => csiArrow('C', mods, app) },
+];
+
+const MODIFIER_KEYS: { readonly id: Modifier; readonly label: string }[] = [
+	{ id: 'ctrl', label: 'Ctrl' },
+	{ id: 'alt', label: 'Alt' },
+];
+
+export class TerminalKeybar extends Disposable {
+
+	private readonly modifiers = new Map<Modifier, ModifierState>();
+	private readonly modifierElements = new Map<Modifier, HTMLElement>();
+	private readonly lastTap = new Map<Modifier, number>();
+
+	// The height layoutBody must reserve. Touch is a device property, not a
+	// runtime state - a non-touch window reserves nothing and builds nothing.
+	readonly height: number;
+
+	constructor(
+		container: HTMLElement,
+		@ITerminalService private readonly terminalService: ITerminalService,
+	) {
+		super();
+
+		this.height = isTouch(dom.getWindow(container)) ? KEYBAR_HEIGHT : 0;
+		if (this.height === 0) {
+			return;
+		}
+
+		for (const { id } of MODIFIER_KEYS) {
+			this.modifiers.set(id, 'off');
+		}
+
+		const bar = dom.append(container, dom.$('.monaco-action-bar.composery-touch-keybar'));
+		bar.style.height = `${KEYBAR_HEIGHT}px`;
+		const list = dom.append(bar, dom.$('ul.actions-container'));
+		for (const key of CONTROL_KEYS) {
+			this.addKey(list, key, () => this.pressControl(key));
+		}
+		for (const mod of MODIFIER_KEYS) {
+			this.modifierElements.set(mod.id, this.addKey(list, { label: mod.label, title: `Sticky ${mod.label} (double-tap to lock)` }, () => this.tapModifier(mod.id)));
+		}
+
+		// A mouse press on the strip must not pull focus off the terminal (touch cannot:
+		// Gesture already preventDefaults touchstart inside the pane).
+		this._register(dom.addDisposableListener(bar, 'mousedown', e => e.preventDefault()));
+		this._register(dom.addDisposableListener(container.ownerDocument, 'beforeinput', e => this.onBeforeInput(e as InputEvent), true));
+	}
+
+	private addKey(list: HTMLElement, key: Pick<KeyDef, 'label' | 'icon' | 'title'>, run: () => void): HTMLElement {
+		const item = dom.append(list, dom.$('li.action-item'));
+		const button = dom.append(item, dom.$('a.action-label'));
+		if (key.icon) {
+			dom.append(button, dom.$(`span.codicon.codicon-${key.icon}`));
+		} else {
+			button.textContent = key.label ?? '';
+		}
+		button.title = key.title;
+		button.setAttribute('role', 'button');
+		button.tabIndex = -1;
+		this._register(Gesture.addTarget(button));
+		this._register(dom.addDisposableListener(button, TouchEventType.Tap, () => run()));
+		this._register(dom.addDisposableListener(button, 'click', () => run()));
+		return button;
+	}
+
+	private activeModifiers(): Set<Modifier> {
+		const active = new Set<Modifier>();
+		for (const [id, state] of this.modifiers) {
+			if (state !== 'off') { active.add(id); }
+		}
+		return active;
+	}
+
+	private pressControl(key: KeyDef): void {
+		const instance = this.terminalService.activeInstance;
+		if (!instance) {
+			return;
+		}
+		const applicationCursor = instance.xterm?.raw.modes.applicationCursorKeysMode === true;
+		instance.sendText(key.bytes(this.activeModifiers(), applicationCursor), false);
+		this.consumeOneShot();
+	}
+
+	private tapModifier(id: Modifier): void {
+		const now = Date.now();
+		const previous = this.modifiers.get(id) ?? 'off';
+		const doubleTap = now - (this.lastTap.get(id) ?? 0) < DOUBLE_TAP_MS;
+		this.lastTap.set(id, now);
+
+		let next: ModifierState;
+		if (previous === 'locked') {
+			next = 'off';
+		} else if (previous === 'oneShot') {
+			next = doubleTap ? 'locked' : 'off';
+		} else {
+			next = 'oneShot';
+		}
+		this.setModifier(id, next);
+	}
+
+	private setModifier(id: Modifier, state: ModifierState): void {
+		this.modifiers.set(id, state);
+		const element = this.modifierElements.get(id);
+		element?.classList.toggle('checked', state !== 'off');
+		element?.classList.toggle('locked', state === 'locked');
+	}
+
+	private consumeOneShot(): void {
+		for (const [id, state] of this.modifiers) {
+			if (state === 'oneShot') { this.setModifier(id, 'off'); }
+		}
+	}
+
+	private onBeforeInput(event: InputEvent): void {
+		const instance = this.terminalService.activeInstance;
+		if (!instance?.hasFocus) {
+			return;
+		}
+		const ctrl = this.modifiers.get('ctrl') !== 'off';
+		const alt = this.modifiers.get('alt') !== 'off';
+		if (!ctrl && !alt) {
+			return;
+		}
+		const data = event.data;
+		if (!data || data.length !== 1) {
+			return;
+		}
+		event.preventDefault();
+		let out = ctrl ? String.fromCharCode(data.charCodeAt(0) & 0x1f) : data;
+		if (alt) {
+			out = '\x1b' + out;
+		}
+		instance.sendText(out, false);
+		this.consumeOneShot();
+	}
+}
