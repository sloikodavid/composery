	"semanticTokenColors": {
		"newOperator": "#cea36f",
		"stringLiteral": "#c48f74",
		"customLiteral": "#a49ec9",
		"numberLiteral": "#a2bd8a"
	},
	"tokenColors": [
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded",
				"string meta.image.inline.markdown",
				"variable.legacy.builtin.python"
			],
			"settings": {
				"foreground": "#c48f74"
			}
		},
		{
			"scope": "emphasis",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
