{
	"cli": {
		"version": "21.0.2",
		"appVersionSource": "remote"
	},
	"build": {
		"preview": {
			"distribution": "internal",
			"environment": "preview",
			"autoIncrement": true,
			"android": {
				"buildType": "apk"
			}
		},
		"production": {
			"environment": "production",
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "internal"
			}
		}
	}
}
