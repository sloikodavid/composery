{
	"expo": {
		"name": "Composery",
		"slug": "composery",
		"version": "0.0.0",
		"orientation": "default",
		"icon": "./assets/images/icon.png",
		"scheme": "composery",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "io.composery",
			"config": {
				"usesNonExemptEncryption": false
			},
			"infoPlist": {
				"NSLocalNetworkUsageDescription": "Allow Composery to connect directly to an instance on your local network.",
				"NSAppTransportSecurity": {
					"NSAllowsArbitraryLoads": false,
					"NSAllowsArbitraryLoadsInWebContent": false,
					"NSAllowsLocalNetworking": true
				}
			}
		},
		"android": {
			"package": "io.composery",
			"allowBackup": false,
			"adaptiveIcon": {
				"backgroundColor": "#242121",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"permissions": ["android.permission.CAMERA"],
			"blockedPermissions": [
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.RECORD_AUDIO",
				"android.permission.SYSTEM_ALERT_WINDOW",
				"android.permission.WRITE_EXTERNAL_STORAGE"
			]
		},
		"updates": {
			"enabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"./plugins/android-dialog-theme.js",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true
					}
				}
			],
			"expo-router",
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Composery to use the camera to scan an instance QR code.",
					"microphonePermission": false,
					"recordAudioAndroid": false
				}
			],
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#cdc9c4",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 76,
					"dark": {
						"backgroundColor": "#1d1b1b",
						"image": "./assets/images/splash-icon-dark.png"
					}
				}
			],
			"expo-font",
			"expo-status-bar"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "4229406d-ffc0-412c-b286-148b698dcf88"
			}
		},
		"owner": "sloikodavid"
	}
}
